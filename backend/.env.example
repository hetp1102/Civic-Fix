# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/grievance_system

# JWT
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# Google OAuth (Google Identity Services - create at https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Hidden admin panel - change this slug to something secret/unguessable, never link it publicly
ADMIN_ROUTE_SECRET=ctrl-9f3a7b2e-panel

# First admin bootstrap (run once via `npm run seed:admin`)
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_PASSWORD=ChangeMe_StrongPassword123
ADMIN_BOOTSTRAP_NAME=Super Admin

# Duplicate-detection thresholds
DUPLICATE_RADIUS_METERS=75
DUPLICATE_TEXT_SIMILARITY=0.6
DUPLICATE_WINDOW_DAYS=30
